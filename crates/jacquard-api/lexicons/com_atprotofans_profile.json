{
  "lexicon": 1,
  "id": "com.atprotofans.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "An identity profile for display and discovery on atprotofans.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "properties": {
          "acceptingSupporters": {
            "type": "boolean",
            "description": "Whether the identity is currently accepting new supporters."
          },
          "avatar": {
            "type": "blob",
            "description": "Avatar image blob reference.",
            "accept": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ],
            "maxSize": 1000000
          },
          "banner": {
            "type": "blob",
            "description": "Banner image blob reference.",
            "accept": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ],
            "maxSize": 1000000
          },
          "description": {
            "type": "string",
            "description": "Profile bio/description with optional rich text.",
            "maxLength": 2560,
            "maxGraphemes": 256
          },
          "displayName": {
            "type": "string",
            "description": "Display name for the profile.",
            "maxLength": 640,
            "maxGraphemes": 64
          },
          "facets": {
            "type": "array",
            "description": "Rich text facets for description annotations.",
            "items": {
              "type": "ref",
              "ref": "app.bsky.richtext.facet"
            }
          }
        }
      }
    }
  }
}