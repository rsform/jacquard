{
  "lexicon": 1,
  "id": "app.protoimsg.chat.poll",
  "defs": {
    "main": {
      "type": "record",
      "description": "A poll within a chat channel. Lives in the creator's repo.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "channel",
          "question",
          "options",
          "createdAt"
        ],
        "properties": {
          "allowMultiple": {
            "type": "boolean",
            "description": "Whether voters can select multiple options.",
            "default": false
          },
          "channel": {
            "type": "string",
            "description": "AT-URI of the channel this poll belongs to.",
            "format": "at-uri"
          },
          "createdAt": {
            "type": "string",
            "description": "Timestamp of poll creation.",
            "format": "datetime"
          },
          "expiresAt": {
            "type": "string",
            "description": "When the poll closes. Omit for no expiry.",
            "format": "datetime"
          },
          "options": {
            "type": "array",
            "description": "Poll answer options.",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "minLength": 2,
            "maxLength": 10
          },
          "question": {
            "type": "string",
            "description": "The poll question.",
            "maxLength": 200
          }
        }
      }
    }
  }
}