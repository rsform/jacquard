{
  "lexicon": 1,
  "id": "sh.tangled.git.temp.defs",
  "defs": {
    "blob": {
      "type": "object",
      "description": "blob metadata. This object doesn't include the blob content",
      "required": [
        "name",
        "mode",
        "size",
        "lastCommit"
      ],
      "properties": {
        "lastCommit": {
          "type": "ref",
          "ref": "#commit"
        },
        "mode": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "The file name"
        },
        "size": {
          "type": "integer",
          "description": "File size in bytes"
        },
        "submodule": {
          "type": "ref",
          "description": "Submodule information if path is a submodule",
          "ref": "#submodule"
        }
      }
    },
    "branch": {
      "type": "object",
      "required": [
        "name",
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "ref",
          "description": "hydrated commit object",
          "ref": "#commit"
        },
        "name": {
          "type": "string",
          "description": "branch name"
        }
      }
    },
    "commit": {
      "type": "object",
      "required": [
        "hash",
        "author",
        "committer",
        "message",
        "tree"
      ],
      "properties": {
        "author": {
          "type": "ref",
          "ref": "#signature"
        },
        "committer": {
          "type": "ref",
          "ref": "#signature"
        },
        "hash": {
          "type": "ref",
          "ref": "#hash"
        },
        "message": {
          "type": "string"
        },
        "tree": {
          "type": "ref",
          "ref": "#hash"
        }
      }
    },
    "hash": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "name",
        "email",
        "when"
      ],
      "properties": {
        "email": {
          "type": "string",
          "description": "Person email"
        },
        "name": {
          "type": "string",
          "description": "Person name"
        },
        "when": {
          "type": "string",
          "description": "Timestamp of the signature",
          "format": "datetime"
        }
      }
    },
    "submodule": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "description": "Branch to track in the submodule"
        },
        "name": {
          "type": "string",
          "description": "Submodule name"
        },
        "url": {
          "type": "string",
          "description": "Submodule repository URL"
        }
      }
    },
    "tag": {
      "type": "object",
      "required": [
        "name",
        "tagger",
        "target"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "tag name"
        },
        "tagger": {
          "type": "ref",
          "ref": "#signature"
        },
        "target": {
          "type": "unknown"
        }
      }
    }
  }
}