{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.listGames",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a list of games on the network.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "did": {
            "type": "string",
            "format": "did"
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          },
          "sort": {
            "type": "string",
            "description": "Field to sort by (e.g. name, createdAt, indexed_at).",
            "default": "indexed_at"
          },
          "sortDirection": {
            "type": "string",
            "description": "Sort direction.",
            "default": "desc",
            "enum": [
              "asc",
              "desc"
            ]
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "games"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "games": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "games.gamesgamesgamesgames.defs#gameSummaryView"
              }
            }
          }
        }
      }
    }
  }
}