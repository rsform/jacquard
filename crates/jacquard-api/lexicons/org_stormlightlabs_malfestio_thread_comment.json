{
  "lexicon": 1,
  "id": "org.stormlightlabs.malfestio.thread.comment",
  "defs": {
    "main": {
      "type": "record",
      "description": "A comment on a deck, card, or note.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subjectRef",
          "body",
          "createdAt"
        ],
        "properties": {
          "body": {
            "type": "string",
            "description": "The comment text.",
            "maxLength": 5000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "replyTo": {
            "type": "string",
            "description": "The parent comment if this is a reply.",
            "format": "at-uri"
          },
          "subjectRef": {
            "type": "string",
            "description": "The root subject being commented on.",
            "format": "at-uri"
          }
        }
      }
    }
  }
}