{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.listClaims",
  "defs": {
    "main": {
      "type": "query",
      "description": "List ownership claims, optionally filtered by status.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 25,
            "minimum": 1,
            "maximum": 100
          },
          "status": {
            "type": "string",
            "knownValues": [
              "pending",
              "approved",
              "denied"
            ]
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "claims"
          ],
          "properties": {
            "claims": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "games.gamesgamesgamesgames.getClaim#claimView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}