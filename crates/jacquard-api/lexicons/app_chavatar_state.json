{
  "lexicon": 1,
  "id": "app.chavatar.state",
  "description": "Execution state for avatar rotation.",
  "defs": {
    "main": {
      "type": "record",
      "description": "Current execution state of rotation.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "cursor",
          "lastUpdated"
        ],
        "properties": {
          "activeSetId": {
            "type": "string",
            "description": "TID of the currently active avatarSet from settings.avatarSets. Undefined when in fallback state or when avatarSets is not configured.",
            "maxLength": 13
          },
          "cursor": {
            "type": "string",
            "description": "TID (ID) of the currently active avatar within the active set.",
            "maxLength": 13
          },
          "lastUpdated": {
            "type": "string",
            "description": "When the avatar was last rotated.",
            "format": "datetime"
          }
        }
      }
    }
  }
}