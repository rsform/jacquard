{
  "lexicon": 1,
  "id": "pink.vase.pod.show",
  "defs": {
    "main": {
      "type": "record",
      "description": "A podcast show. A single user can have multiple shows.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "name",
          "createdAt"
        ],
        "properties": {
          "categories": {
            "type": "array",
            "description": "Podcast categories e.g. 'Technology', 'Comedy'.",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxLength": 3
          },
          "coverArt": {
            "type": "blob",
            "description": "Cover art image. Stored as a blob in the user's PDS.",
            "accept": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "maxSize": 1000000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "explicit": {
            "type": "boolean",
            "description": "Whether the show contains explicit content."
          },
          "language": {
            "type": "string",
            "description": "Primary language of the show, BCP-47 format e.g. 'en', 'es'.",
            "format": "language"
          },
          "name": {
            "type": "string",
            "description": "The display name of the show.",
            "maxLength": 200
          },
          "websiteUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}