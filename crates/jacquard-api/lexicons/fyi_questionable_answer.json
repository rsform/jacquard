{
  "lexicon": 1,
  "id": "fyi.questionable.answer",
  "defs": {
    "main": {
      "type": "record",
      "description": "A proposed answer to a question",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "question",
          "text",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "language"
            },
            "maxLength": 3
          },
          "question": {
            "type": "ref",
            "description": "Indicates the question to which this is a proposed answer to",
            "ref": "com.atproto.repo.strongRef"
          },
          "text": {
            "type": "string",
            "description": "The full text of the answer",
            "minLength": 1,
            "maxLength": 10000,
            "maxGraphemes": 10000
          }
        }
      }
    }
  }
}