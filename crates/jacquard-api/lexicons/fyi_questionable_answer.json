{
  "lexicon": 1,
  "id": "fyi.questionable.answer",
  "defs": {
    "main": {
      "type": "record",
      "description": "A proposed answer to a question",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "question",
          "content",
          "createdAt"
        ],
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 10000,
            "maxGraphemes": 10000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "question": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          }
        }
      }
    }
  }
}