{
  "lexicon": 1,
  "id": "org.atsui.Stack",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Arranges children vertically with consistent spacing.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "children"
          ],
          "properties": {
            "align": {
              "type": "string",
              "description": "Cross-axis alignment of children.",
              "default": "stretch",
              "maxLength": 32,
              "knownValues": [
                "start",
                "center",
                "end",
                "stretch"
              ]
            },
            "children": {
              "type": "unknown"
            },
            "gap": {
              "type": "string",
              "description": "Space between children.",
              "default": "medium",
              "maxLength": 32,
              "knownValues": [
                "none",
                "small",
                "medium",
                "large"
              ]
            },
            "inset": {
              "type": "boolean",
              "description": "Whether this container has inset padding. The theme controls the amount."
            },
            "justify": {
              "type": "string",
              "description": "Main-axis distribution of children.",
              "default": "start",
              "maxLength": 32,
              "knownValues": [
                "start",
                "center",
                "end",
                "between"
              ]
            },
            "opaque": {
              "type": "boolean",
              "description": "Whether the container has an opaque background."
            },
            "separator": {
              "type": "boolean",
              "description": "Whether to show a visual separator between children."
            },
            "sticky": {
              "type": "boolean",
              "description": "Whether the container sticks to the top of the scroll area."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "at.inlay.defs#response"
        }
      }
    }
  }
}