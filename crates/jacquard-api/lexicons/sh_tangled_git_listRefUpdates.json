{
  "lexicon": 1,
  "id": "sh.tangled.git.listRefUpdates",
  "defs": {
    "listItem": {
      "type": "object",
      "required": [
        "uri",
        "value"
      ],
      "properties": {
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "value": {
          "type": "unknown",
          "description": "Embedded sh.tangled.git.refUpdate record"
        }
      }
    },
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "subject"
        ],
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Pagination cursor"
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 1000
          },
          "order": {
            "type": "string",
            "description": "Sort direction by createdAt.",
            "default": "desc",
            "knownValues": [
              "asc",
              "desc"
            ]
          },
          "subject": {
            "type": "string",
            "description": "Repo DID whose ref-update records to list.",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#listItem"
              }
            }
          }
        }
      }
    }
  }
}