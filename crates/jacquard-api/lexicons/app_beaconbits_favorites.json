        "properties": {
          "dids": {
            "type": "array",
            "description": "List of favorited user DIDs",
            "items": {
              "type": "string",
              "format": "did"
            },
            "maxLength": 500
          },
          "updatedAt": {
            "type": "string",
            "description": "Timestamp when the favorites list was last updated",
            "format": "datetime"
          }
        }
      }
    }
  }
