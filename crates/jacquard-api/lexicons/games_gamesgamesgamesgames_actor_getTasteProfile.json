{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.actor.getTasteProfile",
  "defs": {
    "genrePreference": {
      "type": "object",
      "required": [
        "genre",
        "count",
        "percentage"
      ],
      "properties": {
        "count": {
          "type": "integer"
        },
        "genre": {
          "type": "string"
        },
        "percentage": {
          "type": "integer"
        }
      }
    },
    "main": {
      "type": "query",
      "description": "Get a user's taste profile: top genres computed from likes and reviews, plus auto-selected favorite games.",
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "description": "The DID of the user whose taste profile to retrieve."
          },
          "favoriteLimit": {
            "type": "integer",
            "default": 6,
            "minimum": 1,
            "maximum": 12
          },
          "genreLimit": {
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "genres",
            "favorites"
          ],
          "properties": {
            "favorites": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "games.gamesgamesgamesgames.defs#gameView"
              }
            },
            "genres": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#genrePreference"
              }
            }
          }
        }
      }
    }
  }
}