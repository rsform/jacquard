{
  "lexicon": 1,
  "id": "haus.opn.mic.artist",
  "defs": {
    "main": {
      "type": "record",
      "description": "Metadata for an open mic artist.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "name",
          "createdAt"
        ],
        "properties": {
          "artistPic": {
            "type": "blob",
            "accept": [
              "image/*"
            ],
            "maxSize": 1000000
          },
          "bio": {
            "type": "string",
            "maxLength": 1000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "externalLinks": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "genre": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    }
  }
}