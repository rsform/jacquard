{
  "lexicon": 1,
  "id": "pink.vase.pod.follow",
  "defs": {
    "main": {
      "type": "record",
      "description": "A follow relationship between a user and a podcast show.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "show",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "show": {
            "type": "ref",
            "description": "The show being followed.",
            "ref": "com.atproto.repo.strongRef"
          }
        }
      }
    }
  }
}