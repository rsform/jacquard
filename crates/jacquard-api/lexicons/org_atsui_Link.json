{
  "lexicon": 1,
  "id": "org.atsui.Link",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "A hyperlink.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "uri"
          ],
          "properties": {
            "children": {
              "type": "unknown"
            },
            "decoration": {
              "type": "string",
              "maxLength": 32,
              "knownValues": [
                "none",
                "underline"
              ]
            },
            "uri": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "at.inlay.defs#response"
        }
      }
    }
  }
}