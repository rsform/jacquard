{
  "lexicon": 1,
  "id": "sh.tangled.markup.markdown",
  "defs": {
    "main": {
      "type": "object",
      "description": "Tangled Flavored Markdown format text",
      "required": [
        "text"
      ],
      "properties": {
        "blobs": {
          "type": "array",
          "description": "list of blobs referenced in markdown",
          "items": {
            "type": "blob",
            "accept": [
              "image/*"
            ],
            "maxSize": 1000000
          }
        },
        "original": {
          "type": "string",
          "description": "Original Markdown before post-processing. Used to restore original input on edit."
        },
        "text": {
          "type": "string",
          "description": "Final post-processed markdown content that will be rendered"
        }
      }
    }
  }
}