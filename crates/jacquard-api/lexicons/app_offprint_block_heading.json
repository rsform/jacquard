{
  "lexicon": 1,
  "id": "app.offprint.block.heading",
  "defs": {
    "main": {
      "type": "object",
      "required": [
        "plaintext",
        "level"
      ],
      "properties": {
        "facets": {
          "type": "array",
          "description": "Facets for text formatting",
          "items": {
            "type": "ref",
            "ref": "app.offprint.richtext.facet"
          }
        },
        "level": {
          "type": "integer",
          "description": "Heading level (1-3)",
          "minimum": 1,
          "maximum": 3
        },
        "plaintext": {
          "type": "string",
          "description": "The heading text content"
        },
        "textAlign": {
          "type": "string",
          "description": "Text alignment",
          "enum": [
            "left",
            "center",
            "right"
          ]
        }
      }
    }
  }
}