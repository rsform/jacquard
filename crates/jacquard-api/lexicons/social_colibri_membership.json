{
  "lexicon": 1,
  "id": "social.colibri.membership",
  "description": "A declaration that a user would like to be part of a certain community.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "community",
          "createdAt"
        ],
        "properties": {
          "community": {
            "type": "string",
            "description": "AT-URI of the social.colibri.community record being joined",
            "format": "at-uri"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}