{
  "lexicon": 1,
  "id": "blue.recipes.feed.getRecipe",
  "defs": {
    "main": {
      "type": "query",
      "description": "Response model for fetching multiple recipes.",
      "parameters": {
        "type": "params",
        "required": [
          "uris"
        ],
        "properties": {
          "uris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "at-uri"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "recipes"
          ],
          "properties": {
            "recipes": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "blue.recipes.feed.defs#recipeView"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound"
        },
        {
          "name": "InvalidUri"
        }
      ]
    }
  }
}