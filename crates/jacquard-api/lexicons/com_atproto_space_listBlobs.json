{
  "lexicon": 1,
  "id": "com.atproto.space.listBlobs",
  "defs": {
    "main": {
      "type": "query",
      "description": "List the CIDs of blobs referenced by an account's records within a permissioned space, optionally since some revision of that repo. Lets a syncer discover which blobs to fetch via getBlob, and lets an account enumerate the blobs it must carry when migrating a permissioned repo. Scoped to one space: blobs behind permissioned records are never enumerated by com.atproto.sync.listBlobs, which is unauthenticated. Callable with either OAuth (for the authenticated user's own data) or a space credential (for syncing services).",
      "parameters": {
        "type": "params",
        "required": [
          "space",
          "repo"
        ],
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 500,
            "minimum": 1,
            "maximum": 1000
          },
          "repo": {
            "type": "string",
            "description": "The DID of the account whose blobs to list.",
            "format": "did"
          },
          "since": {
            "type": "string",
            "description": "Optional revision of the permissioned repo to list blobs since.",
            "format": "tid"
          },
          "space": {
            "type": "string",
            "description": "Reference to the space.",
            "format": "space-ref"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "cids"
          ],
          "properties": {
            "cids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "cid"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "SpaceNotFound"
        },
        {
          "name": "RepoNotFound"
        },
        {
          "name": "RepoTakendown"
        },
        {
          "name": "RepoSuspended"
        },
        {
          "name": "RepoDeactivated"
        }
      ]
    }
  }
}