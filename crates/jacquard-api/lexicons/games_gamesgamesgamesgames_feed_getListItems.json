{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.feed.getListItems",
  "defs": {
    "listItemView": {
      "type": "object",
      "required": [
        "uri",
        "addedAt",
        "game"
      ],
      "properties": {
        "addedAt": {
          "type": "string",
          "format": "datetime"
        },
        "game": {
          "type": "unknown"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        }
      }
    },
    "main": {
      "type": "query",
      "description": "Get paginated game items from a list.",
      "parameters": {
        "type": "params",
        "required": [
          "listUri"
        ],
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 30,
            "minimum": 1,
            "maximum": 100
          },
          "listUri": {
            "type": "string",
            "description": "The AT-URI of the list.",
            "format": "at-uri"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#listItemView"
              }
            }
          }
        }
      }
    }
  }
}