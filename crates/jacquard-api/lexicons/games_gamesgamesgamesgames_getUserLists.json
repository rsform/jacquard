{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.getUserLists",
  "defs": {
    "listPreviewItem": {
      "type": "object",
      "required": [
        "uri",
        "name"
      ],
      "properties": {
        "media": {
          "type": "unknown"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        }
      }
    },
    "main": {
      "type": "query",
      "description": "Get a user's lists with item counts. Optionally check which lists contain a specific game.",
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "cursor": {
            "type": "string"
          },
          "did": {
            "type": "string",
            "description": "The DID of the user whose lists to retrieve."
          },
          "gameUri": {
            "type": "string",
            "description": "If provided, each list includes a hasGame boolean indicating whether this game is in the list.",
            "format": "at-uri"
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "lists"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "lists": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#userListView"
              }
            }
          }
        }
      }
    },
    "userListView": {
      "type": "object",
      "required": [
        "uri",
        "name",
        "itemCount",
        "createdAt"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "description": {
          "type": "string"
        },
        "hasGame": {
          "type": "boolean"
        },
        "itemCount": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "previewItems": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#listPreviewItem"
          },
          "maxLength": 4
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        }
      }
    }
  }
}