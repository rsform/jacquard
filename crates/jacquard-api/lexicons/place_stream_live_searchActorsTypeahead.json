{
  "lexicon": 1,
  "id": "place.stream.live.searchActorsTypeahead",
  "defs": {
    "actor": {
      "type": "object",
      "required": [
        "did",
        "handle"
      ],
      "properties": {
        "did": {
          "type": "string",
          "description": "The actor's DID",
          "format": "did"
        },
        "handle": {
          "type": "string",
          "description": "The actor's handle",
          "format": "handle"
        }
      }
    },
    "main": {
      "type": "query",
      "description": "Find actor suggestions for a prefix search term. Expected use is for auto-completion during text field entry.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 100
          },
          "q": {
            "type": "string",
            "description": "Search query prefix; not a full query string."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actors"
          ],
          "properties": {
            "actors": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#actor"
              }
            }
          }
        }
      }
    }
  }
}