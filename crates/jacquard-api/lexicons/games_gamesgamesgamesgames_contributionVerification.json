{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.contributionVerification",
  "defs": {
    "main": {
      "type": "record",
      "description": "A permanent record crediting a contributor for an accepted contribution. Never deleted.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "contribution",
          "contributor",
          "contributionType",
          "acceptedBy",
          "createdAt"
        ],
        "properties": {
          "acceptedBy": {
            "type": "string",
            "knownValues": [
              "mod",
              "owner",
              "both"
            ]
          },
          "contribution": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "contributionType": {
            "type": "string",
            "knownValues": [
              "correction",
              "addition",
              "newGame"
            ]
          },
          "contributor": {
            "type": "string",
            "format": "did"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "subject": {
            "type": "string",
            "format": "at-uri"
          }
        }
      }
    }
  }
}