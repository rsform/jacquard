{
  "lexicon": 1,
  "id": "tech.tokimeki.poll.poll",
  "defs": {
    "main": {
      "type": "record",
      "description": "A poll record that can be attached to a post via embed.external",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "options",
          "createdAt",
          "endsAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "endsAt": {
            "type": "string",
            "description": "When the poll closes for voting",
            "format": "datetime"
          },
          "options": {
            "type": "array",
            "description": "Poll options (2-4 choices)",
            "items": {
              "type": "string",
              "maxLength": 100,
              "maxGraphemes": 50
            },
            "minLength": 2,
            "maxLength": 4
          },
          "subject": {
            "type": "ref",
            "description": "Reference to the post this poll is attached to",
            "ref": "com.atproto.repo.strongRef"
          }
        }
      }
    }
  }
}