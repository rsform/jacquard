{
  "lexicon": 1,
  "id": "fyi.frontpage.feed.getFeedSkeleton",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a skeleton of a feed provided by a feed generator. Auth is optional, but may be required by the feed generator.",
      "parameters": {
        "type": "params",
        "required": [
          "feed"
        ],
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Pagination cursor."
          },
          "feed": {
            "type": "string",
            "description": "AT URI of the feed generator record.",
            "format": "at-uri"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of items to return.",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "feed"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "feed": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#skeletonFeedPost"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "UnknownFeed"
        }
      ]
    },
    "skeletonFeedPost": {
      "type": "object",
      "required": [
        "post"
      ],
      "properties": {
        "post": {
          "type": "string",
          "description": "AT URI of the post.",
          "format": "at-uri"
        }
      }
    }
  }
}