{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.richtext.facet",
  "defs": {
    "bold": {
      "type": "object",
      "description": "Facet feature for bold text.",
      "properties": {}
    },
    "byteSlice": {
      "type": "object",
      "description": "Specifies the sub-string range a facet feature applies to. Start index is inclusive, end index is exclusive. Indices are zero-indexed, counting bytes of the UTF-8 encoded text.",
      "required": [
        "byteStart",
        "byteEnd"
      ],
      "properties": {
        "byteEnd": {
          "type": "integer",
          "minimum": 0
        },
        "byteStart": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "heading": {
      "type": "object",
      "description": "Facet feature for a section heading.",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "image": {
      "type": "object",
      "description": "Facet feature for an inline image.",
      "required": [
        "blob"
      ],
      "properties": {
        "alt": {
          "type": "string"
        },
        "blob": {
          "type": "blob",
          "accept": [
            "image/*"
          ],
          "maxSize": 10000000
        },
        "height": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        }
      }
    },
    "italic": {
      "type": "object",
      "description": "Facet feature for italic text.",
      "properties": {}
    },
    "link": {
      "type": "object",
      "description": "Facet feature for a URL.",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "listItem": {
      "type": "object",
      "description": "Facet feature marking text as a list item.",
      "properties": {
        "depth": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "ordered": {
          "type": "boolean"
        }
      }
    },
    "main": {
      "type": "object",
      "description": "Annotation of a sub-string within rich text.",
      "required": [
        "index",
        "features"
      ],
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "union",
            "refs": [
              "#mention",
              "#link",
              "#tag",
              "#bold",
              "#italic",
              "#heading",
              "#listItem",
              "#image",
              "#video"
            ]
          }
        },
        "index": {
          "type": "ref",
          "ref": "#byteSlice"
        }
      }
    },
    "mention": {
      "type": "object",
      "description": "Facet feature for mention of another account.",
      "required": [
        "did"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        }
      }
    },
    "tag": {
      "type": "object",
      "description": "Facet feature for a hashtag.",
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "maxLength": 640,
          "maxGraphemes": 64
        }
      }
    },
    "video": {
      "type": "object",
      "description": "Facet feature for an inline video.",
      "properties": {
        "alt": {
          "type": "string"
        },
        "blob": {
          "type": "blob",
          "accept": [
            "video/*"
          ],
          "maxSize": 200000000
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}