{
  "lexicon": 1,
  "id": "social.flockfeeds.lexical.vocab",
  "defs": {
    "main": {
      "type": "record",
      "description": "Canonical schema for vocabulary entries.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "id",
          "label",
          "createdAt"
        ],
        "properties": {
          "alternateType": {
            "type": "string",
            "description": "Specifies the kind of this record, expected to be a URI (recommended) or plain string."
          },
          "createdAt": {
            "type": "string",
            "description": "Timestamp when this vocab entry was created (ISO 8601).",
            "format": "datetime"
          },
          "description": {
            "type": "string",
            "description": "Optional longer description."
          },
          "id": {
            "type": "string",
            "description": "Canonical URI/IRI for this vocab term.",
            "format": "uri"
          },
          "label": {
            "type": "string",
            "description": "Human-readable label."
          }
        }
      }
    }
  }
}