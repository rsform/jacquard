{
  "lexicon": 1,
  "id": "at.unthread.document.deleteDraft",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete a draft document.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "tid"
          ],
          "properties": {
            "tid": {
              "type": "string",
              "description": "TID of the draft to delete."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "success"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            }
          }
        }
      },
      "errors": [
        {
          "name": "DraftNotFound"
        }
      ]
    }
  }
}