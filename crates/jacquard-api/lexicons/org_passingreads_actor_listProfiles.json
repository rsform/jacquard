{
  "lexicon": 1,
  "id": "org.passingreads.actor.listProfiles",
  "defs": {
    "main": {
      "type": "query",
      "description": "List all profiles for static site generation.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "profiles"
          ],
          "properties": {
            "profiles": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "org.passingreads.actor.defs#profileView"
              }
            }
          }
        }
      }
    }
  }
}