{
  "lexicon": 1,
  "id": "app.offprint.block.imageGrid",
  "defs": {
    "gridImage": {
      "type": "object",
      "properties": {
        "alt": {
          "type": "string",
          "maxGraphemes": 300
        },
        "aspectRatio": {
          "type": "ref",
          "ref": "app.offprint.block.image#aspectRatio"
        },
        "blob": {
          "type": "blob",
          "accept": [
            "image/*"
          ],
          "maxSize": 10000000
        }
      }
    },
    "main": {
      "type": "object",
      "required": [
        "images"
      ],
      "properties": {
        "aspectRatio": {
          "type": "string",
          "description": "Aspect ratio mode",
          "enum": [
            "landscape",
            "portrait",
            "square",
            "mosaic"
          ]
        },
        "caption": {
          "type": "string",
          "description": "Grid caption"
        },
        "gridRows": {
          "type": "integer",
          "description": "Number of rows in the grid",
          "minimum": 1,
          "maximum": 2
        },
        "images": {
          "type": "array",
          "description": "Array of images in the grid (2-6)",
          "items": {
            "type": "ref",
            "ref": "#gridImage"
          },
          "minLength": 2,
          "maxLength": 6
        }
      }
    }
  }
}