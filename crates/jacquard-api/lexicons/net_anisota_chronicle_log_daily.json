{
  "lexicon": 1,
  "id": "net.anisota.chronicle.log.daily",
  "defs": {
    "activityCounts": {
      "type": "object",
      "description": "Aggregate activity counts for the day (no timestamps or URIs)",
      "properties": {
        "likesSent": {
          "type": "integer",
          "description": "Likes sent today",
          "minimum": 0
        },
        "postsCreated": {
          "type": "integer",
          "description": "Posts created today",
          "minimum": 0
        },
        "postsRead": {
          "type": "integer",
          "description": "Posts read today",
          "minimum": 0
        },
        "repliesSent": {
          "type": "integer",
          "description": "Replies sent today",
          "minimum": 0
        },
        "repostsSent": {
          "type": "integer",
          "description": "Reposts sent today",
          "minimum": 0
        }
      }
    },
    "chronicleSignature": {
      "type": "object",
      "description": "ES256 cryptographic signature proving record authenticity",
      "required": [
        "sig",
        "alg",
        "kid",
        "signedAt",
        "nonce",
        "version"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "description": "Signing algorithm (ES256)"
        },
        "kid": {
          "type": "string",
          "description": "Key identifier for the signing key"
        },
        "nonce": {
          "type": "string",
          "description": "Unique random nonce to prevent replay"
        },
        "sig": {
          "type": "string",
          "description": "Base64-encoded ES256 signature"
        },
        "signedAt": {
          "type": "string",
          "description": "When the record was signed",
          "format": "datetime"
        },
        "version": {
          "type": "integer",
          "description": "Signature schema version"
        }
      }
    },
    "engagementCounts": {
      "type": "object",
      "description": "Engagement received on user's posts (aggregate counts only)",
      "properties": {
        "likesReceived": {
          "type": "integer",
          "description": "Likes received on posts today",
          "minimum": 0
        },
        "quotesReceived": {
          "type": "integer",
          "description": "Quotes received today",
          "minimum": 0
        },
        "repliesReceived": {
          "type": "integer",
          "description": "Replies received on posts today",
          "minimum": 0
        },
        "repostsReceived": {
          "type": "integer",
          "description": "Reposts received today",
          "minimum": 0
        }
      }
    },
    "expeditionSummary": {
      "type": "object",
      "description": "Summary of expeditions for the day (details in chronicle.expedition)",
      "properties": {
        "count": {
          "type": "integer",
          "description": "Number of expeditions completed today",
          "minimum": 0
        },
        "currentCampNumber": {
          "type": "integer",
          "description": "Current camp number within the active expedition (0 = exploring, not camped; unset if no active expedition)",
          "minimum": 0
        },
        "currentExpeditionNumber": {
          "type": "integer",
          "description": "Number of the currently active expedition (unset if no active expedition)",
          "minimum": 1
        },
        "totalDuration": {
          "type": "integer",
          "description": "Total expedition duration in milliseconds",
          "minimum": 0
        }
      }
    },
    "inAppCounts": {
      "type": "object",
      "description": "Per-category counts of activity performed inside anisota (never inferred; recorded at write time).",
      "properties": {
        "likes": {
          "type": "integer",
          "description": "Likes created in anisota",
          "minimum": 0
        },
        "posts": {
          "type": "integer",
          "description": "Top-level posts created in anisota",
          "minimum": 0
        },
        "quotes": {
          "type": "integer",
          "description": "Quote posts created in anisota",
          "minimum": 0
        },
        "replies": {
          "type": "integer",
          "description": "Replies created in anisota",
          "minimum": 0
        },
        "reposts": {
          "type": "integer",
          "description": "Reposts created in anisota",
          "minimum": 0
        }
      }
    },
    "inAppDeviceBucket": {
      "type": "object",
      "description": "One device's in-anisota activity counts for the day. Keyed by a stable per-install-per-account device id, so concurrent putRecords from different devices never clobber each other. The reserved deviceId 'scheduled' holds scheduled posts published server-side by the cocoon cron worker on their publish day.",
      "required": [
        "deviceId",
        "counts"
      ],
      "properties": {
        "counts": {
          "type": "ref",
          "ref": "#inAppCounts"
        },
        "deviceId": {
          "type": "string",
          "description": "Stable per-install-per-account device id (random; no fingerprinting). Reserved value 'scheduled' for cocoon-published scheduled posts."
        }
      }
    },
    "main": {
      "type": "record",
      "description": "Daily activity snapshot. Updated throughout the day via putRecord. rkey is YYYY-MM-DD in user's local timezone.",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "date",
          "player",
          "activity",
          "signature",
          "createdAt"
        ],
        "properties": {
          "activity": {
            "type": "ref",
            "ref": "#activityCounts"
          },
          "createdAt": {
            "type": "string",
            "description": "When the daily record was first created",
            "format": "datetime"
          },
          "date": {
            "type": "string",
            "description": "Date string in YYYY-MM-DD format (user's local timezone)"
          },
          "engagement": {
            "type": "ref",
            "ref": "#engagementCounts"
          },
          "expeditionRefs": {
            "type": "array",
            "description": "AT URIs of expedition records that occurred on this day",
            "items": {
              "type": "string"
            }
          },
          "expeditions": {
            "type": "ref",
            "ref": "#expeditionSummary"
          },
          "inApp": {
            "type": "array",
            "description": "First-party ledger of activity performed INSIDE anisota this day, one bucket per device. Optional and additive. The cross-device in-app total per field is the SUM over buckets. Used to compute an honest 'outside' floor (max(0, total - inApp)); a device only ever writes its own bucket.",
            "items": {
              "type": "ref",
              "ref": "#inAppDeviceBucket"
            }
          },
          "patterns": {
            "type": "ref",
            "ref": "#patternsData"
          },
          "player": {
            "type": "ref",
            "ref": "#playerSnapshot"
          },
          "signature": {
            "type": "ref",
            "ref": "#chronicleSignature"
          },
          "updatedAt": {
            "type": "string",
            "description": "When the daily record was last updated",
            "format": "datetime"
          },
          "upperLogRefs": {
            "type": "array",
            "description": "AT URIs of containing logs (weekly, monthly, yearly) this day belongs to",
            "items": {
              "type": "string"
            }
          },
          "walks": {
            "type": "ref",
            "ref": "#walkSummary"
          }
        }
      }
    },
    "patternsData": {
      "type": "object",
      "description": "Activity pattern data for the day based on half-hour blocks",
      "properties": {
        "activeBlockCount": {
          "type": "integer",
          "description": "Number of half-hour blocks with activity today",
          "minimum": 0,
          "maximum": 48
        },
        "activeBlocks": {
          "type": "array",
          "description": "Half-hour slots with activity, as HH:MM strings (e.g. '09:00', '09:30'). Max 48 per day.",
          "items": {
            "type": "string"
          },
          "maxLength": 48
        },
        "longestPatienceHours": {
          "type": "integer",
          "description": "Longest gap in whole hours between notification checks on this day. Monotonic: only ever raised, never lowered. Capped at 48, matching the notification-patience curve's ceiling.",
          "minimum": 0,
          "maximum": 48
        },
        "offlineXPAwarded": {
          "type": "integer",
          "description": "XP awarded for offline time",
          "minimum": 0
        }
      }
    },
    "playerSnapshot": {
      "type": "object",
      "description": "Player state snapshot for this day",
      "required": [
        "level",
        "totalXP"
      ],
      "properties": {
        "itemsAcquiredToday": {
          "type": "integer",
          "description": "Number of items acquired today",
          "minimum": 0
        },
        "itemsConsumedToday": {
          "type": "integer",
          "description": "Number of items consumed/used today",
          "minimum": 0
        },
        "itemsTotal": {
          "type": "integer",
          "description": "Total items in inventory",
          "minimum": 0
        },
        "level": {
          "type": "integer",
          "description": "Player level at end of day",
          "minimum": 1
        },
        "specimensDocumented": {
          "type": "integer",
          "description": "Total specimens in collection",
          "minimum": 0
        },
        "totalXP": {
          "type": "integer",
          "description": "Total accumulated XP",
          "minimum": 0
        },
        "xpGainedToday": {
          "type": "integer",
          "description": "XP gained during this day",
          "minimum": 0
        }
      }
    },
    "walkSummary": {
      "type": "object",
      "description": "Summary of walks for the day (details in chronicle.walk). Parallel to expeditionSummary; both are merged additively.",
      "properties": {
        "count": {
          "type": "integer",
          "description": "Number of walks completed today (additive)",
          "minimum": 0
        },
        "totalDuration": {
          "type": "integer",
          "description": "Total walk duration in minutes (additive)",
          "minimum": 0
        },
        "walkRefs": {
          "type": "array",
          "description": "AT URIs of walk records that occurred on this day",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}