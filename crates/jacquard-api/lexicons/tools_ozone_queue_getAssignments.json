{
  "lexicon": 1,
  "id": "tools.ozone.queue.getAssignments",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get moderator assignments, optionally filtered by active status, queue, or moderator.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "dids": {
            "type": "array",
            "description": "If specified, returns assignments for these moderators only.",
            "items": {
              "type": "string",
              "format": "did"
            }
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          },
          "onlyActive": {
            "type": "boolean",
            "description": "When true, only returns active assignments.",
            "default": true
          },
          "queueIds": {
            "type": "array",
            "description": "If specified, returns assignments for these queues only.",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "assignments"
          ],
          "properties": {
            "assignments": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "tools.ozone.queue.defs#assignmentView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}