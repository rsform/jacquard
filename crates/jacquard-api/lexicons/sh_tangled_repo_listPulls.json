{
  "lexicon": 1,
  "id": "sh.tangled.repo.listPulls",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "subject"
        ],
        "properties": {
          "author": {
            "type": "string",
            "description": "Restrict to pulls authored by this user DID.",
            "format": "did"
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor"
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 1000
          },
          "order": {
            "type": "string",
            "description": "Sort direction by createdAt.",
            "default": "desc",
            "knownValues": [
              "asc",
              "desc"
            ]
          },
          "status": {
            "type": "string",
            "description": "Restrict to pulls whose latest derived status matches.",
            "knownValues": [
              "open",
              "closed",
              "merged"
            ]
          },
          "subject": {
            "type": "string",
            "description": "Repo DID to list pulls for",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#pullListItem"
              }
            }
          }
        }
      }
    },
    "pullListItem": {
      "type": "object",
      "required": [
        "uri",
        "value",
        "state",
        "commentCount"
      ],
      "properties": {
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "commentCount": {
          "type": "integer",
          "description": "Count of sh.tangled.repo.pull.comment records targeting this pull.",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "description": "Latest derived state.",
          "knownValues": [
            "open",
            "closed",
            "merged"
          ]
        },
        "stateUpdatedAt": {
          "type": "string",
          "description": "TID-derived timestamp of the latest pull status record.",
          "format": "datetime"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "value": {
          "type": "unknown",
          "description": "Embedded sh.tangled.repo.pull record"
        }
      }
    }
  }
}