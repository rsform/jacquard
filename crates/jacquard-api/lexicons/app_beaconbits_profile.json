{
  "lexicon": 1,
  "id": "app.beaconbits.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "User preferences and settings for BeaconBits",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "updatedAt"
        ],
        "properties": {
          "allowTags": {
            "type": "string",
            "description": "Who can tag this user in beacons",
            "default": "all",
            "maxGraphemes": 32,
            "knownValues": [
              "all",
              "followers",
              "mutuals",
              "none"
            ]
          },
          "createdAt": {
            "type": "string",
            "description": "Timestamp when settings were first created",
            "format": "datetime"
          },
          "defaultDelayedReveal": {
            "type": "string",
            "description": "Default delayed reveal setting for new beacons",
            "default": "none",
            "maxGraphemes": 16,
            "knownValues": [
              "none",
              "1h",
              "1d",
              "custom"
            ]
          },
          "defaultVisibility": {
            "type": "string",
            "description": "Default visibility for new beacons",
            "default": "public",
            "maxGraphemes": 32,
            "knownValues": [
              "public",
              "followers",
              "mutuals",
              "hidden"
            ]
          },
          "distanceUnit": {
            "type": "string",
            "description": "Preferred distance unit",
            "default": "km",
            "maxGraphemes": 16,
            "knownValues": [
              "km",
              "miles"
            ]
          },
          "hidePastBeacons": {
            "type": "boolean",
            "description": "Whether to hide past beacons from public view",
            "default": false
          },
          "language": {
            "type": "string",
            "description": "Preferred language setting",
            "default": "auto",
            "maxGraphemes": 16,
            "knownValues": [
              "auto",
              "en",
              "es",
              "fr",
              "de",
              "pt-BR",
              "ja",
              "zh-Hans",
              "ko"
            ]
          },
          "markerColor": {
            "type": "string",
            "description": "Hex color code for map marker (e.g., #e24630)",
            "maxGraphemes": 7
          },
          "postBeaconLinks": {
            "type": "boolean",
            "description": "Whether to include beacon links in Bluesky posts",
            "default": true
          },
          "updatedAt": {
            "type": "string",
            "description": "Timestamp when settings were last updated",
            "format": "datetime"
          }
        }
      }
    }
  }
}