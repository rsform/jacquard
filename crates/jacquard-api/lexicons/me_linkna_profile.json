{
  "lexicon": 1,
  "id": "me.linkna.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "A user's custom profile for their Linkname page.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "properties": {
          "avatar": {
            "type": "blob",
            "description": "Custom profile picture for Linkname page.",
            "accept": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ],
            "maxSize": 1000000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "description": {
            "type": "string",
            "description": "Custom profile description for Linkname page.",
            "maxLength": 256
          }
        }
      }
    }
  }
}