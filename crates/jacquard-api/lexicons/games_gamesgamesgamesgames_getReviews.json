{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.getReviews",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get Popfeed reviews for a game, matched by IGDB ID.",
      "parameters": {
        "type": "params",
        "required": [
          "uri"
        ],
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Pagination cursor (offset)."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of reviews to return.",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          },
          "uri": {
            "type": "string",
            "description": "AT URI of the game record.",
            "format": "at-uri"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reviews"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "reviews": {
              "type": "array",
              "items": {
                "type": "union",
                "refs": [
                  "#popfeedReview"
                ]
              }
            }
          }
        }
      }
    },
    "popfeedReview": {
      "type": "object",
      "required": [
        "uri",
        "did",
        "rating",
        "createdAt"
      ],
      "properties": {
        "containsSpoilers": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "did": {
          "type": "string",
          "format": "did"
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "social.popfeed.richtext.facet"
          }
        },
        "rating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        }
      }
    }
  }
}