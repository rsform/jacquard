{
  "lexicon": 1,
  "id": "social.showcase.feed.reaction",
  "defs": {
    "main": {
      "type": "record",
      "description": "Reaction record - emoji reactions to items/collections",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "type",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "subject": {
            "type": "ref",
            "ref": "social.showcase.defs#reactionSubject"
          },
          "type": {
            "type": "string",
            "description": "Emoji reaction shortcode (e.g., :heart:, :fire:, :star:)",
            "maxLength": 100
          }
        }
      }
    }
  }
}