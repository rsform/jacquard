{
  "lexicon": 1,
  "id": "at.margin.reply",
  "revision": 2,
  "description": "A reply to an annotation or another reply",
  "defs": {
    "main": {
      "type": "record",
      "description": "A reply to an annotation (motivation: replying)",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "parent",
          "root",
          "text",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "format": {
            "type": "string",
            "description": "MIME type of the text content",
            "default": "text/plain"
          },
          "parent": {
            "type": "ref",
            "description": "Reference to the parent annotation or reply",
            "ref": "#replyRef"
          },
          "root": {
            "type": "ref",
            "description": "Reference to the root annotation of the thread",
            "ref": "#replyRef"
          },
          "text": {
            "type": "string",
            "description": "Reply text content",
            "maxLength": 10000,
            "maxGraphemes": 3000
          }
        }
      }
    },
    "replyRef": {
      "type": "object",
      "description": "Strong reference to an annotation or reply",
      "required": [
        "uri",
        "cid"
      ],
      "properties": {
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        }
      }
    }
  }
}