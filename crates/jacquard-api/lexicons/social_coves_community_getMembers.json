{
  "lexicon": 1,
  "id": "social.coves.community.getMembers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get list of users with membership status in a community",
      "parameters": {
        "type": "params",
        "required": [
          "community"
        ],
        "properties": {
          "community": {
            "type": "string",
            "description": "DID or handle of the community",
            "format": "at-identifier"
          },
          "cursor": {
            "type": "string",
            "maxLength": 500
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          },
          "sort": {
            "type": "string",
            "default": "reputation",
            "maxLength": 64,
            "knownValues": [
              "reputation",
              "recent",
              "alphabetical"
            ]
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "members"
          ],
          "properties": {
            "cursor": {
              "type": "string",
              "maxLength": 500
            },
            "members": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#memberView"
              }
            }
          }
        }
      }
    },
    "memberView": {
      "type": "object",
      "required": [
        "did",
        "memberSince"
      ],
      "properties": {
        "avatar": {
          "type": "string",
          "format": "uri"
        },
        "commentCount": {
          "type": "integer",
          "description": "Number of comments in this community",
          "minimum": 0
        },
        "did": {
          "type": "string",
          "format": "did"
        },
        "displayName": {
          "type": "string",
          "maxLength": 1280,
          "maxGraphemes": 128
        },
        "handle": {
          "type": "string",
          "format": "handle"
        },
        "isModerator": {
          "type": "boolean"
        },
        "memberSince": {
          "type": "string",
          "format": "datetime"
        },
        "postCount": {
          "type": "integer",
          "description": "Number of posts in this community",
          "minimum": 0
        },
        "reputation": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}