{
  "lexicon": 1,
  "id": "place.wisp.fs",
  "defs": {
    "directory": {
      "type": "object",
      "required": [
        "type",
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#entry"
          },
          "maxLength": 500
        },
        "type": {
          "type": "string",
          "const": "directory"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "name",
        "node"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 255
        },
        "node": {
          "type": "union",
          "refs": [
            "#file",
            "#directory"
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "type",
        "blob"
      ],
      "properties": {
        "base64": {
          "type": "boolean",
          "description": "True if blob content is base64-encoded (used to bypass PDS content sniffing)"
        },
        "blob": {
          "type": "blob",
          "description": "Content blob ref",
          "accept": [
            "*/*"
          ],
          "maxSize": 1000000
        },
        "encoding": {
          "type": "string",
          "description": "Content encoding (e.g., gzip for compressed files)",
          "enum": [
            "gzip"
          ]
        },
        "mimeType": {
          "type": "string",
          "description": "Original MIME type before compression"
        },
        "type": {
          "type": "string",
          "const": "file"
        }
      }
    },
    "main": {
      "type": "record",
      "description": "Virtual filesystem manifest for a Wisp site",
      "record": {
        "type": "object",
        "required": [
          "site",
          "root",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "fileCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "root": {
            "type": "ref",
            "ref": "#directory"
          },
          "site": {
            "type": "string"
          }
        }
      }
    }
  }
}