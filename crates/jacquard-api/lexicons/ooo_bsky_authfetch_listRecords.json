{
  "lexicon": 1,
  "id": "ooo.bsky.authfetch.listRecords",
  "revision": 1,
  "defs": {
    "main": {
      "type": "query",
      "description": "Lists a range of private records in a hidden repository that match a specific collection. Requires auth.",
      "parameters": {
        "type": "params",
        "required": [
          "collection"
        ],
        "properties": {
          "collection": {
            "type": "string",
            "description": "The NSID of the record collection.",
            "format": "nsid"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "description": "The number of records to return.",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          },
          "reverse": {
            "type": "boolean",
            "description": "Flag to reverse the order of the returned records."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "records"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#record"
              }
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "description": "A record in the hidden repository.",
      "required": [
        "uri",
        "strategy",
        "value"
      ],
      "properties": {
        "strategy": {
          "type": "ref",
          "description": "The strategy used to authenticate fetch requests for this record.",
          "ref": "ooo.bsky.authfetch.strategy"
        },
        "uri": {
          "type": "string",
          "description": "The AT URI of the record.",
          "format": "at-uri"
        },
        "value": {
          "type": "unknown",
          "description": "The stored private record value."
        }
      }
    }
  }
}