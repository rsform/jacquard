{
  "lexicon": 1,
  "id": "blue.recipes.feed.getRecipes",
  "defs": {
    "main": {
      "type": "query",
      "description": "Response model for fetching multiple recipes.",
      "parameters": {
        "type": "params",
        "properties": {
          "author": {
            "type": "string",
            "format": "at-identifier"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "recipes",
            "nextCursor"
          ],
          "properties": {
            "nextCursor": {
              "type": "string"
            },
            "recipes": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "blue.recipes.feed.defs#recipeView"
              }
            }
          }
        }
      }
    }
  }
}