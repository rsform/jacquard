{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.getContributionStats",
  "defs": {
    "badge": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "contributionStats": {
      "type": "object",
      "required": [
        "totalContributions",
        "corrections",
        "additions",
        "newGames",
        "uniqueEntities",
        "ownerAccepted"
      ],
      "properties": {
        "additions": {
          "type": "integer"
        },
        "corrections": {
          "type": "integer"
        },
        "newGames": {
          "type": "integer"
        },
        "ownerAccepted": {
          "type": "integer"
        },
        "totalContributions": {
          "type": "integer"
        },
        "uniqueEntities": {
          "type": "integer"
        }
      }
    },
    "main": {
      "type": "query",
      "description": "Get contribution statistics and badges for a user.",
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "stats",
            "badges"
          ],
          "properties": {
            "badges": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#badge"
              }
            },
            "stats": {
              "type": "ref",
              "ref": "#contributionStats"
            }
          }
        }
      }
    }
  }
}