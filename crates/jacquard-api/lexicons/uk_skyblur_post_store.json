{
  "lexicon": 1,
  "id": "uk.skyblur.post.store",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stores a restricted post in the Skyblur AppView. Auth required.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "text",
            "uri",
            "visibility"
          ],
          "properties": {
            "additional": {
              "type": "string",
              "maxLength": 100000,
              "maxGraphemes": 10000
            },
            "text": {
              "type": "string",
              "maxLength": 3000,
              "maxGraphemes": 300
            },
            "uri": {
              "type": "string",
              "description": "The URI must include the logged-in user's DID in the format at://did...",
              "format": "at-uri"
            },
            "visibility": {
              "type": "string",
              "enum": [
                "followers",
                "following",
                "mutual"
              ]
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "success"
          ],
          "properties": {
            "message": {
              "type": "string"
            },
            "success": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}