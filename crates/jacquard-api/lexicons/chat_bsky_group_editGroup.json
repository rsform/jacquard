{
  "lexicon": 1,
  "id": "chat.bsky.group.editGroup",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "[NOTE: This is under active development and should be considered unstable while this note is here]. Edits group settings.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "convoId",
            "name"
          ],
          "properties": {
            "convoId": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1280,
              "maxGraphemes": 128
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "convo"
          ],
          "properties": {
            "convo": {
              "type": "ref",
              "ref": "chat.bsky.convo.defs#convoView"
            }
          }
        }
      },
      "errors": [
        {
          "name": "ConvoLocked"
        },
        {
          "name": "InvalidConvo"
        },
        {
          "name": "InsufficientRole"
        }
      ]
    }
  }
}