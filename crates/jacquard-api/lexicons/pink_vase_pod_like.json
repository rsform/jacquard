{
  "lexicon": 1,
  "id": "pink.vase.pod.like",
  "defs": {
    "main": {
      "type": "record",
      "description": "A like on a podcast show or episode.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "subject": {
            "type": "ref",
            "description": "The show or episode being liked.",
            "ref": "com.atproto.repo.strongRef"
          }
        }
      }
    }
  }
}