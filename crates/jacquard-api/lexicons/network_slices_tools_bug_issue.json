{
  "lexicon": 1,
  "id": "network.slices.tools.bug.issue",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "bug",
          "issue",
          "createdAt"
        ],
        "properties": {
          "bug": {
            "type": "string",
            "description": "Reference to the bug report",
            "format": "at-uri"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "issue": {
            "type": "string",
            "description": "Reference to the linked issue",
            "format": "at-uri"
          }
        }
      }
    }
  }
}