{
  "lexicon": 1,
  "id": "network.slices.tools.richtext.facet",
  "defs": {
    "bold": {
      "type": "object",
      "description": "Facet feature for bold text.",
      "required": [],
      "properties": {}
    },
    "byteSlice": {
      "type": "object",
      "description": "Specifies the sub-string range a facet feature applies to. Start index is inclusive, end index is exclusive. Indices are zero-indexed, counting bytes of the UTF-8 encoded text.",
      "required": [
        "byteStart",
        "byteEnd"
      ],
      "properties": {
        "byteEnd": {
          "type": "integer",
          "minimum": 0
        },
        "byteStart": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "code": {
      "type": "object",
      "description": "Facet feature for inline code.",
      "required": [],
      "properties": {}
    },
    "codeBlock": {
      "type": "object",
      "description": "Facet feature for fenced code blocks.",
      "required": [],
      "properties": {
        "lang": {
          "type": "string",
          "description": "Optional language identifier for syntax highlighting."
        }
      }
    },
    "italic": {
      "type": "object",
      "description": "Facet feature for italic text.",
      "required": [],
      "properties": {}
    },
    "link": {
      "type": "object",
      "description": "Facet feature for a URL.",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "main": {
      "type": "object",
      "description": "Annotation of a sub-string within rich text.",
      "required": [
        "index",
        "features"
      ],
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "union",
            "refs": [
              "#link",
              "#bold",
              "#italic",
              "#code",
              "#codeBlock"
            ]
          }
        },
        "index": {
          "type": "ref",
          "ref": "#byteSlice"
        }
      }
    }
  }
}