{
  "lexicon": 1,
  "id": "sh.tangled.repo.checkPushAllowed",
  "defs": {
    "main": {
      "type": "query",
      "description": "Check whether the holder of a public key is allowed to push to a repo.",
      "parameters": {
        "type": "params",
        "required": [
          "repo",
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Public key in OpenSSH authorized_keys format.",
            "maxLength": 4096
          },
          "repo": {
            "type": "string",
            "description": "A repo DID."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "allowed"
          ],
          "properties": {
            "allowed": {
              "type": "boolean",
              "description": "Whether the key's owner may push to the repo."
            },
            "did": {
              "type": "string",
              "description": "DID the key resolved to, if a match was found.",
              "format": "did"
            }
          }
        }
      },
      "errors": [
        {
          "description": "The repo could not be resolved on this knot.",
          "name": "RepoNotFound"
        },
        {
          "description": "Missing or malformed parameters.",
          "name": "InvalidRequest"
        }
      ]
    }
  }
}