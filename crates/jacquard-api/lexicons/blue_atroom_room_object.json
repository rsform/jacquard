{
  "lexicon": 1,
  "id": "blue.atroom.room.object",
  "defs": {
    "localizedName": {
      "type": "object",
      "required": [
        "lang",
        "value"
      ],
      "properties": {
        "lang": {
          "type": "string",
          "maxLength": 16
        },
        "value": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "main": {
      "type": "record",
      "description": "A 3D object that can be placed in a room.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "name",
          "model",
          "scale",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "model": {
            "type": "blob",
            "accept": [
              "model/gltf-binary"
            ],
            "maxSize": 10485760
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "nameLangs": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#localizedName"
            }
          },
          "scale": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      }
    }
  }
}