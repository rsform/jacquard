{
  "lexicon": 1,
  "id": "blue.backyard.actor.profile",
  "description": "A declaration of a Backyard account profile.",
  "defs": {
    "main": {
      "type": "record",
      "description": "A declaration of a Backyard account profile.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "properties": {
          "avatar": {
            "type": "blob",
            "description": "Small avatar image for the user.",
            "accept": [
              "image/png",
              "image/jpeg"
            ],
            "maxSize": 1000000
          },
          "banner": {
            "type": "blob",
            "description": "Larger horizontal banner image.",
            "accept": [
              "image/png",
              "image/jpeg"
            ],
            "maxSize": 1000000
          },
          "createdAt": {
            "type": "string",
            "description": "When the profile was initially created.",
            "format": "datetime"
          },
          "description": {
            "type": "string",
            "description": "Free-form profile description text (bio).",
            "maxLength": 2560,
            "maxGraphemes": 256
          },
          "displayName": {
            "type": "string",
            "description": "Display name for the user.",
            "maxLength": 640,
            "maxGraphemes": 64
          },
          "pronouns": {
            "type": "string",
            "description": "User's preferred pronouns.",
            "maxLength": 640,
            "maxGraphemes": 64
          }
        }
      }
    }
  }
}