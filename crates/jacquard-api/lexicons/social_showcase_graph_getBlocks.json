{
  "lexicon": 1,
  "id": "social.showcase.graph.getBlocks",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get blocked users. Requires authentication.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Pagination cursor",
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "blocks"
          ],
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "social.showcase.defs#profileView"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}