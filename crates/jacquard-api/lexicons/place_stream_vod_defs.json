{
  "lexicon": 1,
  "id": "place.stream.vod.defs",
  "defs": {
    "commentView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "author",
        "record",
        "indexedAt",
        "likeCount"
      ],
      "properties": {
        "author": {
          "type": "ref",
          "ref": "app.bsky.actor.defs#profileViewBasic"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        },
        "likeCount": {
          "type": "integer",
          "description": "Number of likes on this comment.",
          "minimum": 0
        },
        "record": {
          "type": "unknown"
        },
        "replyTo": {
          "type": "union",
          "description": "The parent comment this one replies to, if any. A non-recursive view (it carries no replyTo of its own), so the thread is flattened to a single hop; walk `record.reply` to follow the chain further.",
          "refs": [
            "#commentViewBasic"
          ]
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        }
      }
    },
    "commentViewBasic": {
      "type": "object",
      "description": "A comment view without its own `replyTo`, used to represent the parent of a reply without recursively nesting the whole thread.",
      "required": [
        "uri",
        "cid",
        "author",
        "record",
        "indexedAt",
        "likeCount"
      ],
      "properties": {
        "author": {
          "type": "ref",
          "ref": "app.bsky.actor.defs#profileViewBasic"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        },
        "likeCount": {
          "type": "integer",
          "description": "Number of likes on this comment.",
          "minimum": 0
        },
        "record": {
          "type": "unknown"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        }
      }
    }
  }
}