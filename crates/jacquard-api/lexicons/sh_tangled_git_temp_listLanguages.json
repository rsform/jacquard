{
  "lexicon": 1,
  "id": "sh.tangled.git.temp.listLanguages",
  "defs": {
    "language": {
      "type": "object",
      "required": [
        "name",
        "size"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Programming language name"
        },
        "size": {
          "type": "integer",
          "description": "Total size of files in this language (bytes)"
        }
      }
    },
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "repo"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Git reference (branch, tag, or commit SHA)",
            "default": "HEAD"
          },
          "repo": {
            "type": "string",
            "description": "DID of the repository",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "ref",
            "languages",
            "total"
          ],
          "properties": {
            "languages": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#language"
              }
            },
            "ref": {
              "type": "string",
              "description": "The git reference used"
            },
            "total": {
              "type": "integer",
              "description": "Total size of all analyzed files in bytes"
            }
          }
        }
      },
      "errors": [
        {
          "description": "Repository not found or access denied",
          "name": "RepoNotFound"
        },
        {
          "description": "Git reference not found",
          "name": "RefNotFound"
        },
        {
          "description": "Invalid request parameters",
          "name": "InvalidRequest"
        }
      ]
    }
  }
}