{
  "lexicon": 1,
  "id": "blue.skytalk.talk.thread",
  "defs": {
    "main": {
      "type": "record",
      "description": "A thread in a channel",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "channelId",
          "title",
          "createdAt"
        ],
        "properties": {
          "channelId": {
            "type": "string",
            "description": "The channel this thread belongs to"
          },
          "createdAt": {
            "type": "string",
            "description": "Timestamp of thread creation",
            "format": "datetime"
          },
          "text": {
            "type": "string",
            "description": "The text content of the thread",
            "maxLength": 4000,
            "maxGraphemes": 40000
          },
          "title": {
            "type": "string",
            "description": "The title of the thread",
            "maxLength": 300,
            "maxGraphemes": 3000
          }
        }
      }
    }
  }
}