{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.listOrgGames",
  "defs": {
    "main": {
      "type": "query",
      "description": "List games associated with an organization.",
      "parameters": {
        "type": "params",
        "required": [
          "org"
        ],
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          },
          "org": {
            "type": "string",
            "format": "at-uri"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "games"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "games": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "games.gamesgamesgamesgames.defs#gameSummaryView"
              }
            }
          }
        }
      }
    }
  }
}