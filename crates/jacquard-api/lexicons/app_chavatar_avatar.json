{
  "lexicon": 1,
  "id": "app.chavatar.avatar",
  "description": "An image used for automatic avatar rotation.",
  "defs": {
    "main": {
      "type": "record",
      "description": "An individual avatar image record.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "avatar",
          "createdAt"
        ],
        "properties": {
          "avatar": {
            "type": "blob",
            "description": "The image data for the avatar.",
            "accept": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ],
            "maxSize": 2000000
          },
          "createdAt": {
            "type": "string",
            "description": "The timestamp when the avatar was created.",
            "format": "datetime"
          }
        }
      }
    }
  }
}