{
  "lexicon": 1,
  "id": "sh.tangled.feed.comment",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "body",
          "createdAt"
        ],
        "properties": {
          "body": {
            "type": "union",
            "refs": [
              "sh.tangled.markup.markdown"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "pullRoundIdx": {
            "type": "integer",
            "description": "optional pull submission round index. required when subject is sh.tangled.repo.pull",
            "minimum": 0
          },
          "replyTo": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "subject": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          }
        }
      }
    }
  }
}