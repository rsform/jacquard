{
  "lexicon": 1,
  "id": "social.coves.feed.getCommunity",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a feed of posts from a specific community",
      "parameters": {
        "type": "params",
        "required": [
          "community"
        ],
        "properties": {
          "community": {
            "type": "string",
            "description": "Get community feed for specific community (DID or handle)",
            "format": "at-identifier"
          },
          "cursor": {
            "type": "string",
            "maxLength": 500
          },
          "limit": {
            "type": "integer",
            "default": 15,
            "minimum": 1,
            "maximum": 50
          },
          "sort": {
            "type": "string",
            "description": "Sort order for community feed",
            "default": "hot",
            "maxLength": 64,
            "knownValues": [
              "hot",
              "top",
              "new"
            ]
          },
          "timeframe": {
            "type": "string",
            "description": "Timeframe for top sorting (only applies when sort=top)",
            "default": "day",
            "maxLength": 64,
            "knownValues": [
              "hour",
              "day",
              "week",
              "month",
              "year",
              "all"
            ]
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "feed"
          ],
          "properties": {
            "cursor": {
              "type": "string",
              "maxLength": 500
            },
            "feed": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "social.coves.feed.defs#feedViewPost"
              }
            }
          }
        }
      }
    }
  }
}