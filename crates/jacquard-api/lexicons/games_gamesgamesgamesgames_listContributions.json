{
  "lexicon": 1,
  "id": "games.gamesgamesgamesgames.listContributions",
  "defs": {
    "main": {
      "type": "query",
      "description": "List community contributions, optionally filtered by status, subject, or contributor.",
      "parameters": {
        "type": "params",
        "properties": {
          "contributor": {
            "type": "string",
            "description": "Filter to contributions from a specific user.",
            "format": "did"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 25,
            "minimum": 1,
            "maximum": 100
          },
          "status": {
            "type": "string",
            "knownValues": [
              "pending",
              "approved",
              "denied",
              "needsRevision"
            ]
          },
          "subject": {
            "type": "string",
            "description": "Filter to contributions targeting a specific entity.",
            "format": "at-uri"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "contributions"
          ],
          "properties": {
            "contributions": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "games.gamesgamesgamesgames.getContribution#contributionView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}