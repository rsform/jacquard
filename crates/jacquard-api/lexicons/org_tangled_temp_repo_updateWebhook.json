{
  "lexicon": 1,
  "id": "org.tangled.temp.repo.updateWebhook",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Update an existing webhook. Only supplied fields are changed.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "repoDid",
            "id"
          ],
          "properties": {
            "active": {
              "type": "boolean"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "id": {
              "type": "integer",
              "description": "Webhook ID to update."
            },
            "repoDid": {
              "type": "string",
              "description": "DID of the repository as minted by the knot.",
              "format": "did"
            },
            "secret": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "errors": [
        {
          "name": "WebhookNotFound"
        }
      ]
    }
  }
}