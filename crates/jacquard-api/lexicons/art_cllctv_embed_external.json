{
  "lexicon": 1,
  "id": "art.cllctv.embed.external",
  "defs": {
    "main": {
      "type": "object",
      "required": [
        "uri",
        "title",
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "thumb": {
          "type": "blob",
          "accept": [
            "image/*"
          ],
          "maxSize": 1000000
        },
        "thumbHash": {
          "type": "string",
          "maxLength": 640,
          "maxGraphemes": 64
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "uri",
        "title",
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "thumb": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}