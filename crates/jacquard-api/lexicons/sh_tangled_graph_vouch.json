{
  "lexicon": 1,
  "id": "sh.tangled.graph.vouch",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "kind",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "evidences": {
            "type": "array",
            "description": "Optional list of ATURIs serving as evidence for this vouch (ex. issues, PRs)",
            "items": {
              "type": "string",
              "format": "at-uri"
            },
            "maxLength": 10
          },
          "kind": {
            "type": "string",
            "description": "Whether this user is being vouched for or denounced",
            "default": "vouch",
            "enum": [
              "vouch",
              "denounce"
            ]
          },
          "reason": {
            "type": "string",
            "description": "The reason for this vouch/denouncement",
            "maxLength": 2560,
            "maxGraphemes": 256
          }
        }
      }
    }
  }
}