{
  "lexicon": 1,
  "id": "org.passingreads.book.getBook",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get full details about a specific book.",
      "parameters": {
        "type": "params",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The book ID (short ID from QR code)"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "ref",
              "ref": "org.passingreads.book.defs#statefulBook"
            }
          }
        }
      }
    }
  }
}