{
  "lexicon": 1,
  "id": "site.standard.publication",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "url",
          "name"
        ],
        "properties": {
          "basicTheme": {
            "type": "ref",
            "ref": "site.standard.theme.basic"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "maxGraphemes": 300
          },
          "icon": {
            "type": "blob",
            "accept": [
              "image/*"
            ],
            "maxSize": 1000000
          },
          "name": {
            "type": "string",
            "maxLength": 1280,
            "maxGraphemes": 128
          },
          "preferences": {
            "type": "ref",
            "ref": "#preferences"
          },
          "theme": {
            "type": "union",
            "refs": [
              "pub.leaflet.publication#theme"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "showComments": {
          "type": "boolean",
          "default": true
        },
        "showInDiscover": {
          "type": "boolean",
          "default": true
        },
        "showMentions": {
          "type": "boolean",
          "default": true
        },
        "showPrevNext": {
          "type": "boolean",
          "default": false
        },
        "showRecommends": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}