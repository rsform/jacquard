          "type": "string",
          "description": "Show keyboard shortcuts help",
          "maxLength": 50
        },
        "notifications": {
          "type": "string",
          "description": "Open notifications",
          "maxLength": 50
        },
        "postComposer": {
          "type": "string",
          "description": "Open post composer",
          "maxLength": 50
        },
        "stats": {
          "type": "string",
          "description": "Open stats modal",
          "maxLength": 50
        },
        "touchMenu": {
          "type": "string",
          "description": "Open touch menu",
          "maxLength": 50
        }
      }
    },
    "keyboardShortcutsNavigation": {
      "type": "object",
      "description": "Navigation keyboard shortcuts",
      "properties": {
        "arrowDown": {
          "type": "string",
          "description": "Scroll down or next item",
          "maxLength": 50
        },
        "arrowLeft": {
          "type": "string",
          "description": "Go back to previous card",
          "maxLength": 50
        },
        "arrowRight": {
          "type": "string",
          "description": "Advance to next card",
          "maxLength": 50
        },
        "arrowUp": {
          "type": "string",
          "description": "Scroll up or previous item",
          "maxLength": 50
        },
        "escape": {
          "type": "string",
          "description": "Exit fullscreen or close modals",
          "maxLength": 50
        }
      }
    },
    "keyboardShortcutsPostInteractions": {
      "type": "object",
      "description": "Post interaction keyboard shortcuts",
      "properties": {
        "like": {
          "type": "string",
          "description": "Like current post",
          "maxLength": 50
        },
        "quote": {
          "type": "string",
          "description": "Quote current post",
          "maxLength": 50
        },
        "reply": {
          "type": "string",
          "description": "Reply to current post",
          "maxLength": 50
        },
        "repost": {
          "type": "string",
          "description": "Repost current post",
          "maxLength": 50
        }
      }
    },
    "main": {
      "type": "record",
      "description": "User settings for the Anisota app, synchronized across devices via ATProto",
      "key": "literal:settings",
      "record": {
        "type": "object",
        "required": [
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "behaviorSettings": {
            "type": "ref",
            "ref": "#behaviorSettings"
          },
          "controlOrder": {
            "type": "array",
            "description": "Order of control buttons",
            "items": {
              "type": "string",
              "enum": [
                "back",
                "shuffle",
                "flip",
                "like",
                "repost",
                "reply",
                "quote",
                "list",
                "postList",
                "accountList",
                "commentButton",
                "multiEngageButton",
                "multiRepostButton",
                "engageButton",
                "copyButton",
                "copyPostText",
                "copyAuthorDID",
                "copyPostLink",
                "relationshipButton",
                "fetch",
                "feedSwitcher",
                "positionButton",
                "forward",
                "fullscreen",
                "delete",
                "quickAccess",
                "leafletPublications",
                "textOnlyMode"
              ]
            }
          },
          "controlSettings": {
            "type": "ref",
            "ref": "#controlSettings"
          },
          "createdAt": {
            "type": "string",
            "description": "When the settings record was first created",
            "format": "datetime"
          },
          "theme": {
            "type": "string",
            "description": "Selected color theme",
            "enum": [
              "night",
              "day"
            ]
          },
          "uiSettings": {
            "type": "ref",
            "ref": "#uiSettings"
          },
          "updatedAt": {
            "type": "string",
            "description": "When the settings were last updated",
            "format": "datetime"
          },
          "version": {
            "type": "integer",
            "description": "Settings schema version for backward compatibility",
            "minimum": 1
          }
        }
      }
    },
    "moderationSettings": {
      "type": "object",
      "description": "Content moderation and filtering settings",
      "properties": {
        "mutedAccountsHandling": {
          "type": "string",
          "description": "How to handle posts from muted accounts",
          "enum": [
            "show",
            "warn",
            "hide"
          ]
        },
        "mutedContentHandling": {
          "type": "string",
          "description": "How to handle posts containing muted words or phrases",
          "enum": [
            "show",
            "warn",
            "hide"
          ]
        }
      }
    },
    "statsVisibleSections": {
