{
  "lexicon": 1,
  "id": "place.stream.multistream.listTargets",
  "defs": {
    "main": {
      "type": "query",
      "description": "List a range of targets for rebroadcasting a Streamplace stream.",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "description": "The number of targets to return.",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "targets"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "place.stream.multistream.defs#targetView"
              }
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "value"
      ],
      "properties": {
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "value": {
          "type": "unknown"
        }
      }
    }
  }
}