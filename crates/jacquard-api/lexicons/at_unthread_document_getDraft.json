{
  "lexicon": 1,
  "id": "at.unthread.document.getDraft",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a single draft document by TID.",
      "parameters": {
        "type": "params",
        "required": [
          "tid"
        ],
        "properties": {
          "tid": {
            "type": "string",
            "description": "TID of the draft to retrieve."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "at.unthread.document.putDraft#draftView"
        }
      },
      "errors": [
        {
          "name": "DraftNotFound"
        }
      ]
    }
  }
}