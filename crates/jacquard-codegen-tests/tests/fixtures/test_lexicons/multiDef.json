{
  "lexicon": 1,
  "id": "pub.leaflet.poll.definition",
  "defs": {
    "main": {
      "type": "record",
      "description": "Poll definition record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["question", "options"],
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 300
          },
          "options": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#option"
            },
            "minLength": 2,
            "maxLength": 4
          },
          "endsAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "option": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "vote": {
      "type": "object",
      "required": ["pollRef", "optionIndex"],
      "properties": {
        "pollRef": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef"
        },
        "optionIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
