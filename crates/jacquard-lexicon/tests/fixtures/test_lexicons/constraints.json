{
  "lexicon": 1,
  "id": "test.constraints.validation",
  "defs": {
    "main": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "description": "User handle"
        },
        "bio": {
          "type": "string",
          "maxGraphemes": 256,
          "minGraphemes": 1
        },
        "age": {
          "type": "integer",
          "minimum": 13,
          "maximum": 120,
          "default": 18
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minLength": 0,
          "maxLength": 10
        },
        "role": {
          "type": "string",
          "default": "user",
          "knownValues": ["user", "admin", "moderator"]
        }
      }
    }
  }
}
